DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/medicore
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/medicore_test

JWT_SECRET_KEY=replace_with_a_secure_random_secret
